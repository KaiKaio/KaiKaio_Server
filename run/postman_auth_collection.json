{
  "info": {
    "name": "Auth - Access/Refresh Tokens",
    "_postman_id": "auth-collection-0001",
    "description": "Collection to test login, protected endpoint, refresh and logout flows.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userName\": \"{{userName}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": {
          "raw": "http://localhost:3000/api/user/login",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api","user","login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "if (data && data.accessToken) pm.environment.set('accessToken', data.accessToken);",
              "if (data && data.refreshToken) pm.environment.set('refreshToken', data.refreshToken);",
              "pm.test('登录返回 200 且有 token', () => { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Verify (protected)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "http://localhost:3000/api/user/verifyToken",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api","user","verifyToken"]
        }
      }
    },
    {
      "name": "Refresh",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
        },
        "url": {
          "raw": "http://localhost:3000/api/user/refresh",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api","user","refresh"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "if (data && data.accessToken) pm.environment.set('accessToken', data.accessToken);",
              "if (data && data.refreshToken) pm.environment.set('refreshToken', data.refreshToken);",
              "pm.test('刷新返回 200 并包含新 token', () => { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Logout",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
        },
        "url": {
          "raw": "http://localhost:3000/api/user/logout",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api","user","logout"]
        }
      }
    }
  ],
  "variable": [
    { "key": "userName", "value": "testuser" },
    { "key": "password", "value": "<client-encrypted-password>" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" }
  ]
}
