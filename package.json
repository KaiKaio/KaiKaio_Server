{
  "name": "blogserver",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon src/app.ts",
    "start": "cross-env NODE_ENV=production node dist/app.js",
    "build": "tsc",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@koa/router": "^15.5.0",
    "@ladjs/koa-views": "^9.0.0",
    "ali-oss": "^6.22.0",
    "axios": "^1.18.0",
    "debug": "^4.4.3",
    "dotenv": "^17.4.2",
    "ejs": "^5.0.2",
    "jsonwebtoken": "^9.0.3",
    "koa": "^3.2.0",
    "koa-bodyparser": "^4.4.1",
    "koa-convert": "^1.2.0",
    "koa-json": "^2.0.2",
    "koa-jwt": "^4.0.0",
    "koa-logger": "^4.0.0",
    "koa-onerror": "^5.0.1",
    "koa-static": "^5.0.0",
    "mongoose": "^8.24.0"
  },
  "devDependencies": {
    "@types/ali-oss": "^6.23.3",
    "@types/debug": "^4.1.13",
    "@types/ejs": "^3.1.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/koa": "^2.15.1",
    "@types/koa-bodyparser": "^4.3.13",
    "@types/koa-json": "^2.0.24",
    "@types/koa-logger": "^3.1.5",
    "@types/koa-router": "^7.4.9",
    "@types/koa-static": "^4.0.4",
    "@types/koa-views": "^2.0.4",
    "@types/node": "^25.9.0",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
